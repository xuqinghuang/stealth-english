{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "stealth-english",
  "version": "0.1.0",
  "identifier": "com.stealthenglish.app",
  "build": {
    "frontendDist": "../web",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run web"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; media-src 'self' data: blob:"
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  }
}
